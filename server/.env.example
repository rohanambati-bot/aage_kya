# ─── Server (Express) environment variables ──────────────────────────────────
# Copy this file to server/.env and fill in real values.
# NEVER commit server/.env — it is in .gitignore.

# Port for the Express server (default: 5000)
PORT=5000

# Allowed frontend origins (comma-separated) for CORS.
# REQUIRED in production — the server now refuses to start in production without
# it, because the previous fallback reflected any Origin while also sending
# credentials, letting any website read authenticated API responses.
# Example: ALLOWED_ORIGINS=https://aage-kya.vercel.app,https://www.aagekya.com
# ALLOWED_ORIGINS=

# ─── Admin access ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses granted the 'admin' role.
# There is NO hardcoded default any more: the old built-in list contained
# admin@gmail.com (a public free-mail address anyone could register) and trusted
# any @admin.aagekya.com signup, both of which granted full admin rights.
# Only confirmed-email accounts on this list are treated as admins.
# ADMIN_EMAILS=you@yourdomain.com

# ─── Demo / judge logins (NON-PRODUCTION ONLY) ───────────────────────────────
# Set to 'true' to enable the credential-free demo bearer tokens
# (demo-student-token / demo-mentor-token / demo-admin-token).
# These grant full sessions with NO password, so they are opt-in and are ignored
# whenever NODE_ENV=production. Leave unset for any real deployment.
# ENABLE_DEMO_LOGIN=false

# Groq API key (server-side ONLY — never use VITE_ prefix for this)
# Get your FREE key from: https://console.groq.com → API Keys
# Model used: llama-3.3-70b-versatile (default) — override with GROQ_MODEL env var
GROQ_API_KEY=your_groq_api_key_here

# Supabase project credentials (same project as frontend)
# Get from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (OPTIONAL for analytics, REQUIRED for seed.js)
# Used by GET /api/analytics and node seed.js (Phase 3 RAG seeding).
# CAUTION: This key bypasses Row Level Security. Keep it server-side only and
# NEVER commit a real value to this example file.
# Get from: Supabase dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Phase 3: RAG Data Setup ──────────────────────────────────────────────────
# After filling in the keys above and running supabase_schema.sql:
#   cd server && node seed.js
# This seeds ~108 real colleges and 25 verified scholarships into Supabase.
# The /api/guidance endpoint will use this data to ground the AI's responses.

# ─── Optional: Override AI model ─────────────────────────────────────────────
# Default model: llama-3.3-70b-versatile
# Other fast Groq options: llama-3.1-8b-instant, mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── Mentor Booking Notifications ────────────────────────────────────────────
# Email address that receives a notification whenever a student submits a
# "Book Mentor" request. Requires RESEND_API_KEY to be configured.
# ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
